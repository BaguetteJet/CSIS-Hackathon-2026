# The same settings for running the service in IntelliJ (or ./gradlew bootRun) with the dev kit in
# Docker: the dev kit publishes its ports on localhost. Load this file in your run configuration
# (EnvFile plugin, or paste into "Environment variables"); scripts/run-local.sh loads it for you.
SERVICE_NAME=platform
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DB_URL=jdbc:mysql://localhost:3306/platform
DB_USER=platform
DB_PASSWORD=platform
CLOCK_URL=http://localhost:8090/internal/clock
JWT_PUBLIC_KEY_URL=http://localhost:8080/.well-known/jwks.json
MAIL_HOST=localhost
MAIL_PORT=1025
# Orders only: LEDGER_URL, where the hold call goes. Set, the call goes over HTTP; empty, the
# in-process stub answers (HOLD_CLIENT=http or HOLD_CLIENT=stub forces either). One of:
#   http://localhost:8091  the fake Ledger, on the fakes' laptop-only port (Orders' default): orders reach Paid
#   http://localhost:8090  the dev kit's hold stub, to test each answer (./hold); orders never reach Paid
LEDGER_URL=
# Two instances on one laptop: SERVER_PORT=8081 and SERVER_PORT=8082 (scripts/run-local.sh 8081)
SERVER_PORT=8081
