# The settings your two containers get from the dev kit (docker compose up). Every value is the
# dev kit's own default: you should not need to change any of them.
# Running in IntelliJ instead? Use local.env (README, "Commands").
SERVICE_NAME=ledger
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
DB_URL=jdbc:mysql://mysql:3306/ledger
DB_USER=ledger
DB_PASSWORD=ledger
CLOCK_URL=http://clock:8080/internal/clock
JWT_PUBLIC_KEY_URL=http://signin:8080/.well-known/jwks.json
MAIL_HOST=mailpit
MAIL_PORT=1025
# Orders only: LEDGER_URL, where the hold call goes. Set, the call goes over HTTP; empty, the
# in-process stub answers (HOLD_CLIENT=http or HOLD_CLIENT=stub forces either). One of:
#   http://fakes:8080      the fake Ledger (Orders' default): orders reach Paid
#   http://ledger:8080     a real Ledger's two containers
#   http://hold-stub:8080  the dev kit's hold stub, to test each answer (./hold); no charges follow,
#                          so orders never reach Paid
LEDGER_URL=
