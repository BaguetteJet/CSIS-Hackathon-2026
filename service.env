# The settings your two containers get from the dev kit (docker compose up). Every value is the
# dev kit's own default: you should not need to change any of them.
# Running in IntelliJ instead? Use local.env (README, "Run it in your IDE").
SERVICE_NAME=platform
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
DB_URL=jdbc:mysql://mysql:3306/platform
DB_USER=platform
DB_PASSWORD=platform
CLOCK_URL=http://clock:8080/internal/clock
JWT_PUBLIC_KEY_URL=http://signin:8080/.well-known/jwks.json
MAIL_HOST=mailpit
MAIL_PORT=1025
# Orders only: HOLD_CLIENT=http and LEDGER_URL=http://ledger:8080 (the fake Ledger, the hold stub or the real one)
HOLD_CLIENT=stub
